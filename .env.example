# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API (or "API Keys").
# .env.local is git-ignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (sb_secret_... or legacy "service_role"). Not used yet;
# needed later for the Monday.com integration. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
