# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API (or "API Keys").
# .env.local is git-ignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server only from here down. Never prefix any of these with NEXT_PUBLIC_. ----

# Claude bots (docs/PLAN-claude-bots.md).
ANTHROPIC_API_KEY=
# Optional: bot messages per person per day (default 50).
# BOT_DAILY_LIMIT=50

# Connectors (docs/CONNECTORS.md).
# Supabase secret key (sb_secret_... or legacy "service_role"): lets the server
# store and read connector tokens, which browsers can never see.
SUPABASE_SECRET_KEY=
# Encrypts connector tokens before they're saved. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTORS_SECRET=
# One app per tool you want to connect. Leave a pair empty to hide that Connect button.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
